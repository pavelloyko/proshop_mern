{
  "name": "WF1 — Manual Feature Toggle",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "feature-toggle",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook_1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "auth-check",
              "leftValue": "={{ $headers['x-auth'] }}",
              "rightValue": "proshop-secret",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if_auth_2",
      "name": "Auth Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [250, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'UNAUTHORIZED', message: 'Invalid or missing x-auth header' }) }}",
        "options": {
          "statusCode": 401
        }
      },
      "id": "respond_unauth_3",
      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [500, -200]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.action }}",
        "rules": {
          "rules": [
            {
              "value2": "enable",
              "output": 0
            },
            {
              "value2": "disable",
              "output": 1
            },
            {
              "value2": "testing",
              "output": 2
            },
            {
              "value2": "traffic",
              "output": 3
            }
          ]
        },
        "fallbackOutput": 4
      },
      "id": "switch_action_4",
      "name": "Switch Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [500, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5150/api/features/{{ $json.body.feature_name }}/state",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-auth",
              "value": "proshop-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ state: 'Enabled' }) }}",
        "options": {}
      },
      "id": "http_enable_5",
      "name": "Enable Feature",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, -200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5150/api/features/{{ $json.body.feature_name }}/state",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-auth",
              "value": "proshop-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ state: 'Disabled' }) }}",
        "options": {}
      },
      "id": "http_disable_6",
      "name": "Disable Feature",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, -50]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5150/api/features/{{ $json.body.feature_name }}/state",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-auth",
              "value": "proshop-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ state: 'Testing' }) }}",
        "options": {}
      },
      "id": "http_testing_7",
      "name": "Set Testing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "pct_type",
              "leftValue": "={{ typeof $json.body.traffic_percentage }}",
              "rightValue": "number",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "pct_min",
              "leftValue": "={{ $json.body.traffic_percentage }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "pct_max",
              "leftValue": "={{ $json.body.traffic_percentage }}",
              "rightValue": 100,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if_traffic_8",
      "name": "Traffic % Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 250]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5150/api/features/{{ $json.body.feature_name }}/traffic",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-auth",
              "value": "proshop-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ percentage: $json.body.traffic_percentage }) }}",
        "options": {}
      },
      "id": "http_traffic_9",
      "name": "Set Traffic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 250]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'INVALID_PERCENTAGE', message: 'percentage must be between 0 and 100. Got: ' + $json.body.traffic_percentage }) }}",
        "options": {
          "statusCode": 400
        }
      },
      "id": "respond_invalid_pct_10",
      "name": "Respond Invalid %",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'INVALID_ACTION', message: 'Unknown action. Must be: enable, disable, testing, traffic' }) }}",
        "options": {
          "statusCode": 400
        }
      },
      "id": "respond_invalid_action_11",
      "name": "Respond Invalid Action",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {}
      },
      "id": "respond_success_12",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Auth Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auth Check": {
      "main": [
        [
          {
            "node": "Switch Action",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Unauthorized",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch Action": {
      "main": [
        [
          {
            "node": "Enable Feature",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Disable Feature",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set Testing",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Traffic % Valid?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Invalid Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enable Feature": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Disable Feature": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Testing": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Traffic % Valid?": {
      "main": [
        [
          {
            "node": "Set Traffic",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Invalid %",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Traffic": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
